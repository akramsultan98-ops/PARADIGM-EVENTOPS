# ─── PARADIGM EVENTOPS — environment configuration ───────────────────────
# Copy to .env and fill in. NEVER commit real secrets.

# PostgreSQL connection
DATABASE_URL="postgresql://eventops:eventops_dev@localhost:5432/eventops?schema=public"
# Separate database used by integration tests (it is reset by the tests)
TEST_DATABASE_URL="postgresql://eventops:eventops_dev@localhost:5432/eventops_test?schema=public"

# Session signing secret — at least 32 random characters (openssl rand -base64 48)
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Application URL (used in exports and links)
APP_URL="http://localhost:3000"

# AI provider. Leave ANTHROPIC_API_KEY empty to run with the deterministic
# rule-based extractor only (the UI states clearly which engine produced a result).
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# File storage driver: "local" (development) or "s3" (S3-compatible object storage)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MAX_UPLOAD_MB="20"

# Optional OR-Tools optimisation microservice (services/optimizer). Empty = built-in TS scheduler.
OPTIMIZER_URL=""

# Optional n8n webhook for outbound notifications (WhatsApp/email bridges). Empty = disabled.
N8N_WEBHOOK_URL=""

# Development only: enables the documented demo login accounts. MUST be "false" in production.
ENABLE_DEMO_LOGIN="true"
